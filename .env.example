# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://messeger:messeger@localhost:5432/messeger

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=messeger-files
MINIO_USE_SSL=false

# Auth
API_KEY_SALT_ROUNDS=12
SESSION_SECRET=change-me-in-production-minimum-32-chars
MAGIC_LINK_EXPIRY_MINUTES=15
SESSION_EXPIRY_HOURS=168

# Email (for magic links)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@messeger.dev

# App
APP_URL=http://localhost:3000
APP_NAME=Messeger Egentic

# Rate Limiting
RATE_LIMIT_AGENT_RPM=60
RATE_LIMIT_HUMAN_RPM=120
RATE_LIMIT_REGISTER_RPH=10

# Webhooks
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3
