# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://agentdialog:agentdialog@localhost:5432/agentdialog

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentdialog-files
MINIO_USE_SSL=false

# Auth
API_KEY_SALT_ROUNDS=12
SESSION_SECRET=change-me-in-production-minimum-32-chars
VERIFICATION_CODE_EXPIRY_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
SESSION_EXPIRY_HOURS=168

# Email (SMTP, outbound)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@agentdialog.io

# Reply addressing: queries are answered by replying to
# {REPLY_LOCAL_PART}+{queryId}@{REPLY_DOMAIN}
REPLY_LOCAL_PART=reply
REPLY_DOMAIN=reply.agentdialog.io

# App
APP_URL=http://localhost:3000
APP_NAME=AgentDialog

# Rate Limiting
RATE_LIMIT_GLOBAL_RPM=200
RATE_LIMIT_AGENT_RPM=60
RATE_LIMIT_HUMAN_RPM=120
RATE_LIMIT_REGISTER_RPH=10

# CORS (comma-separated origins, "*" for dev)
CORS_ORIGINS=*

# Webhooks
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3
