# AgentDialog on-premise environment. Copy to .env and fill in the values an
# operator must choose. `bun run scripts/admin.ts init-env` does this for you,
# generating SESSION_SECRET and WEBHOOK_ENCRYPTION_KEY and prompting for SMTP.
#
# No value marked <generated-by-admin-init-env> has a working default: the app
# refuses to start without it.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
DEPLOYMENT_MODE=onprem
LOG_LEVEL=info

# Database. The compose file names its service "postgres"; for a managed
# database of your own, point DATABASE_URL wherever yours is. The password here
# and POSTGRES_PASSWORD must match: init-env generates one password and writes
# it into both.
POSTGRES_PASSWORD=<generated-by-admin-init-env>
DATABASE_URL=postgresql://agentdialog:change-me@postgres:5432/agentdialog

# Redis. Same story: the compose service is "redis".
REDIS_URL=redis://redis:6379

# Storage — embedded MinIO by default. The app talks to it on 127.0.0.1:9000
# inside the container and data lives in the minio-data volume. Set
# MINIO_EMBEDDED=false and point MINIO_* at your own S3-compatible store to use
# one instead.
MINIO_EMBEDDED=true
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=<generated-by-admin-init-env>
MINIO_SECRET_KEY=<generated-by-admin-init-env>
MINIO_BUCKET=agentdialog-files
MINIO_USE_SSL=false
# Public base URL that your reverse proxy maps to the container's port 9000.
# Presigned upload/download URLs are rewritten to this so a browser can reach
# them. Unset keeps the raw internal URLs.
MINIO_PUBLIC_URL=https://files.agentdialog.corp.example

# Auth
API_KEY_SALT_ROUNDS=12
SESSION_SECRET=<generated-by-admin-init-env>
VERIFICATION_CODE_EXPIRY_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
SESSION_EXPIRY_HOURS=168

# Email — REQUIRED in on-premise production. No relay, no sign-in codes, no
# humans. The app refuses to start with a local SMTP_HOST here.
SMTP_HOST=smtp.corp.example
SMTP_PORT=465
SMTP_USER=agentdialog@corp.example
SMTP_PASS=<set-by-admin-init-env>
SMTP_FROM=agentdialog@corp.example
SMTP_SECURE=true

# Reply addressing, used only by the dormant inbound webhook. Outbound mail
# never carries a per-query Reply-To.
REPLY_LOCAL_PART=reply
REPLY_DOMAIN=reply.agentdialog.corp.example

# App — must be the public https URL behind your reverse proxy
APP_URL=https://agentdialog.corp.example
APP_NAME=AgentDialog

# Rate Limiting
RATE_LIMIT_GLOBAL_RPM=200
RATE_LIMIT_AGENT_RPM=60
RATE_LIMIT_HUMAN_RPM=120
RATE_LIMIT_REGISTER_RPH=10

# CORS (comma-separated origins, "*" for dev)
CORS_ORIGINS=*

# Webhooks
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3
# 32 bytes in base64: openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=<generated-by-admin-init-env>
# Verifies the dormant inbound email webhook. Required in production whatever
# the mode; init-env generates one.
INBOUND_EMAIL_WEBHOOK_SECRET=<generated-by-admin-init-env>
# On-premise: agents may deliver webhooks to services inside your network. This
# is the point of on-premise. Leave unset to keep the public-only guard.
WEBHOOK_ALLOW_PRIVATE_TARGETS=true

# Money questions above this amount are treated as high risk whatever the agent declared
RISK_ELEVATION_AMOUNT=1000

# Where a reply to a notification email lands. A real mailbox with an
# auto-responder pointing people back to the app — nothing reads it in code.
REPLY_TO_ADDRESS=